{
  "name": "quarto space",
  "image": "ghcr.io/mcanouil/quarto-codespaces:latest",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {
      "version": "release",
      "installTinyTex": "false",
      "installChromium": "false"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto",
        "ms-python.python",
        "ms-python.black-formatter",
        "ms-python.flake8",
        "ms-python.vscode-pylance",
        "ms-python.pylint",
        "ms-python.isort",
        "ms-toolsai.jupyter",
        "Posit.air-vscode"
      ],
      "settings": {
      }
    }
  }
}
